# Copy to .env and fill in. NEVER commit .env.
# The backend reads these; docker compose passes them through.

# ---------- Plaid ----------
# Same client_id across environments; the SECRET differs per environment.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                 # sandbox | production  <- see docs/04
ALLOW_PRODUCTION=false            # must be true to allow PLAID_ENV=production
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# OAuth return path. These are MUTUALLY EXCLUSIVE and chosen per platform:
# iOS uses the redirect URI (a hosted blank page + universal link), Android
# uses the applicationId. Sending the wrong one dead-ends silently at the
# bank's login. Both can be set; the app says which it is.
PLAID_REDIRECT_URI=
PLAID_ANDROID_PACKAGE_NAME=org.dollarden.app
# Plaid signs webhooks with a JWT in the Plaid-Verification header.
API_BASE_URL=https://budget.example.org
# Must be https and reachable from the internet, or Plaid will not
# post to it and transactions arrive only on the scheduled pull.
# The environment is appended automatically: .../plaid/webhook/sandbox
PLAID_WEBHOOK_URL=https://budget.example.org/plaid/webhook

# ---------- Database ----------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433           # own instance; avoids the CasaOS Postgres on 5432
POSTGRES_DB=dollarden
POSTGRES_USER=dollarden
POSTGRES_PASSWORD=

# ---------- Crypto ----------
# 32-byte urlsafe-base64 key used to encrypt Plaid access_tokens at rest.
# Generate: python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# LOSING THIS KEY MEANS RE-LINKING EVERY BANK = BURNING CONNECTION CREDITS.
TOKEN_ENCRYPTION_KEY=
JWT_SIGNING_KEY=

# Addresses allowed to set X-Forwarded-For, so rate limiting counts the
# real client rather than the proxy. Loopback only unless set. Behind a
# reverse proxy, put its address on the container network here.
TRUSTED_PROXIES=127.0.0.1

# ---------- AI ----------
# Entirely optional. With AI_PROVIDER=none the budget works exactly as
# it does otherwise, and anything that would have been categorised
# automatically waits in the review queue instead (ADR 0003).
#
#   none     no AI at all
#   managed  an Ollama host this server may wake, and power on if a
#            relay is wired up (see POWER_RELAY_* below)
#   custom   an Ollama host that is simply expected to be running
AI_PROVIDER=none
AI_HOST_URL=http://127.0.0.1:11434
AI_MODEL_VISION=gemma4:12b
AI_MODEL_TEXT=gemma4:12b
AI_CONFIDENCE_THRESHOLD=0.85
# Pull from Plaid on a schedule as well as on webhooks.
#
# Required on a plain-HTTP install: Plaid will not post webhooks to an
# unencrypted URL, so without this the app only updates when someone
# pulls down on the screen. Worth keeping on even with HTTPS, because
# a missed webhook otherwise stops transactions silently.
#
# Minimum 2 minutes, enforced in code whatever is written here.
PLAID_SYNC_ENABLED=true
PLAID_SYNC_INTERVAL_MINUTES=60

# Hold AI work overnight so the inference machine stays asleep. Set the
# timezone to where that machine physically is, not where the server
# is. Set AI_QUIET_ENABLED=false to run at any hour.
AI_QUIET_ENABLED=true
AI_QUIET_TIMEZONE=UTC
AI_QUIET_START_HOUR=0
AI_QUIET_END_HOUR=8

# Port the API is published on, for reaching it directly without a
# reverse proxy (http://<your-server>:21821).
DOLLARDEN_PORT=21821

# Wake-on-LAN API used to bring the AI host up on demand (already deployed).
WOL_API_URL=
WOL_API_TOKEN=
AI_WAKE_TIMEOUT_SECONDS=90
AI_IDLE_SHUTDOWN_MINUTES=30
# Longest one inference request may take before it counts as a failure.
# This is the only bound on a host that has stopped answering, and the
# job queue is serial, so it is also the per-job cost of a wedged
# machine. See docs/16-deck-power.md, 2026-11-16.
AI_REQUEST_TIMEOUT_SECONDS=120
# After a request stalls (host on, nothing came back), how long to stop
# sending it work instead of timing out job after job.
AI_STALL_BACKOFF_SECONDS=900

# GPU headroom probe on the AI host (deploy/deck/gpu-probe.py)
GPU_PROBE_URL=
GPU_PROBE_TOKEN=
