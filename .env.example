# Copy to .env and fill in. NEVER commit .env.
# The backend reads these; docker compose passes them through.

# ---------- Plaid ----------
# Same client_id across environments; the SECRET differs per environment.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                 # sandbox | production  <- see docs/04
ALLOW_PRODUCTION=false            # must be true to allow PLAID_ENV=production
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=
# Plaid signs webhooks with a JWT in the Plaid-Verification header.
API_BASE_URL=https://budget.example.org
PLAID_WEBHOOK_URL=https://budget.example.org/plaid/webhook

# ---------- Database ----------
POSTGRES_HOST=nnf-postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433           # own instance; avoids the CasaOS Postgres on 5432
POSTGRES_DB=nnf
POSTGRES_USER=nnf
POSTGRES_PASSWORD=

# ---------- Crypto ----------
# 32-byte urlsafe-base64 key used to encrypt Plaid access_tokens at rest.
# Generate: python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# LOSING THIS KEY MEANS RE-LINKING EVERY BANK = BURNING CONNECTION CREDITS.
TOKEN_ENCRYPTION_KEY=
JWT_SIGNING_KEY=

# ---------- AI ----------
AI_PROVIDER=deck                  # deck | custom | none
AI_DECK_URL=http://192.168.86.196:11434
AI_MODEL_VISION=gemma4:12b
AI_MODEL_TEXT=gemma4:12b
AI_CONFIDENCE_THRESHOLD=0.85
# Wake-on-LAN API used to bring the AI host up on demand (already deployed).
WOL_API_URL=https://example.org/wol
WOL_API_TOKEN=
AI_WAKE_TIMEOUT_SECONDS=90
AI_IDLE_SHUTDOWN_MINUTES=30

# GPU headroom probe on the AI host (deploy/deck/gpu-probe.py)
GPU_PROBE_URL=http://192.168.86.196:11435
GPU_PROBE_TOKEN=
