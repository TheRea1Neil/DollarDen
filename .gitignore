# ---- personal notes: never commit ----
# Notes about one particular deployment -- hostnames, addresses, which
# machine is which. Useful to its owner, meaningless and a little
# revealing to everyone else.
*.local.md
NOTES.local.md

# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
**/plaid_credentials*
**/access_tokens*

# ---- backend ----
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/

# ---- flutter / dart ----
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
app/build/
app/.dart_tool/
*.iml
.idea/
ios/Pods/
ios/.symlinks/
android/.gradle/
android/local.properties

# ---- db / local data ----
*.sqlite
*.sqlite3
*.db
pgdata/
backups/*.sql
backups/*.dump
!backups/.gitkeep
# The live dump directory on the Pi.
deploy/backups/

# ---- os / editor ----
.DS_Store
Thumbs.db
*.swp
.vscode/

# ---- flutter build output ----
app/build/
app/.dart_tool/
app/ios/Pods/
app/macos/Pods/
app/ios/.symlinks/
app/macos/Flutter/ephemeral/
app/ios/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh

# Receipt photographs used for testing. The OCR TEXT is kept as a
# fixture (backend/tests/fixtures/), redacted; the photographs are not
# committed — they carry a card number and transaction ids in plain
# sight, and git keeps them forever.
*.jpg
*.jpeg
# ...except the brand source art, which tools/make_icons.py reads to
# regenerate every launcher icon. Losing it means redrawing the logo.
!brand/*.jpeg

# ---- one deployment's operational notes: kept locally, not published ----
# Runbooks and credentials for the author's own machines. Useful to
# whoever runs that box, meaningless to everyone else, and a little
# revealing. The design docs alongside them are deliberately NOT here:
# they explain why the system is the way it is, which is the most
# valuable thing in the repository.
docs/09-pi-operations.md
docs/13-test-account.md
