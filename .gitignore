# The live dump directory on the Pi.
deploy/backups/

# ---- os / editor ----
.DS_Store
Thumbs.db
*.swp
.vscode/

# ---- flutter build output ----
app/build/
app/.dart_tool/
app/ios/Pods/
app/macos/Pods/
app/ios/.symlinks/
app/macos/Flutter/ephemeral/
app/ios/Flutter/ephemeral/
