# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
**/plaid_credentials*
**/access_tokens*

# ---- backend ----
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/

