#!/usr/bin/env bash
# Drive the iOS simulator: look at it, tap it, type into it.
#
# Built for UI/UX work on the app. The useful part is not the tapping —
# it is `find`, which reads the live accessibility tree, so an element
# is located by its LABEL rather than by guessing pixel coordinates off
# a screenshot. That survives layout changes; coordinates do not.
#
#   sim shot [name]        screenshot to tools/shots/<name>.png
#   sim tree               every element with its label and frame
#   sim find <text>        elements whose label contains <text>
#   sim tap <text>         tap the centre of the first match
#   sim tapxy <x> <y>      tap a point, when there is nothing to match on
#   sim type <text>        type into whatever has focus
#   sim key <name>         return | delete | home
#   sim swipe <x1> <y1> <x2> <y2> [dur]
#   sim scroll up|down     half a screen, from the middle
#   sim back               the usual back-button spot
#   sim launch | relaunch | terminate
#   sim boot [name]        boot a simulator by name (default: iPhone 17)
#
# Needs: brew install facebook/fb/idb-companion, and the venv alongside
# this script (see tools/README.md).
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
IDB="$HERE/.idbvenv/bin/idb"
export IDB_COMPANION_PATH="${IDB_COMPANION_PATH:-/opt/homebrew/bin/idb_companion}"
BUNDLE="${NNF_BUNDLE:-org.nonsensefinance.nnf}"
SHOTS="$HERE/shots"

udid() {
  if [[ -n "${NNF_SIM:-}" ]]; then echo "$NNF_SIM"; return; fi
  xcrun simctl list devices booted -j | python3 "$HERE/_udid.py"
}

tree_json() { "$IDB" ui describe-all --udid "$(udid)" 2>/dev/null; }

# Find elements by label, returning "x y w h | type | label" per match.
find_el() { tree_json | python3 "$HERE/_tree.py" find "$1"; }

case "${1:-}" in
  shot)
    mkdir -p "$SHOTS"
    name="${2:-$(date +%H%M%S)}"
    out="$SHOTS/$name.png"
    xcrun simctl io "$(udid)" screenshot --type=png "$out" >/dev/null 2>&1
    echo "$out"
    ;;

  tree) tree_json | python3 "$HERE/_tree.py" all ;;

  find)  find_el "${2:?need text}" ;;

  tap)
    match="$(find_el "${2:?need text}" | head -1)"
    [[ -z "$match" ]] && { echo "no element matching: $2" >&2; exit 1; }
    read -r x y w h _ <<<"$match"
    cx=$(( x + w / 2 )); cy=$(( y + h / 2 ))
    "$IDB" ui tap --udid "$(udid)" "$cx" "$cy"
    echo "tapped ($cx,$cy) — ${match#*| }"
    ;;

  tapxy) "$IDB" ui tap --udid "$(udid)" "${2:?x}" "${3:?y}"; echo "tapped ($2,$3)" ;;
  type)  "$IDB" ui text --udid "$(udid)" "${2:?text}" ;;
  key)
    case "${2:?key}" in
      return) "$IDB" ui key --udid "$(udid)" 40 ;;
      delete) "$IDB" ui key --udid "$(udid)" 42 ;;
      home)   "$IDB" ui key --udid "$(udid)" 227 ;;
      *) echo "unknown key: $2" >&2; exit 1 ;;
    esac
    ;;

  swipe)
    "$IDB" ui swipe --udid "$(udid)" \
      --duration "${6:-0.3}" "${2:?x1}" "${3:?y1}" "${4:?x2}" "${5:?y2}"
    ;;

  scroll)
    case "${2:-down}" in
      down) "$IDB" ui swipe --udid "$(udid)" --duration 0.25 200 620 200 260 ;;
      up)   "$IDB" ui swipe --udid "$(udid)" --duration 0.25 200 260 200 620 ;;
    esac
    ;;

  back)      "$IDB" ui tap --udid "$(udid)" 24 70 ;;
  launch)    "$IDB" launch --udid "$(udid)" "$BUNDLE" ;;
  relaunch)  "$IDB" terminate --udid "$(udid)" "$BUNDLE" 2>/dev/null || true
             sleep 1; "$IDB" launch --udid "$(udid)" "$BUNDLE" ;;
  terminate) "$IDB" terminate --udid "$(udid)" "$BUNDLE" ;;

  boot)
    name="${2:-iPhone 17}"
    xcrun simctl boot "$name" 2>/dev/null || true
    open -a Simulator
    echo "booting $name"
    ;;

  *) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
